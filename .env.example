# ---------------------------------------------------------------------------
# Настройки Telegram-бота для Codex (OpenAI). Скопируйте в .env и заполните.
# Файл читает systemd (EnvironmentFile) или python-dotenv при ручном запуске.
# ---------------------------------------------------------------------------

# Токен бота от @BotFather (обязательно)
TELEGRAM_BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Белый список Telegram ID через запятую (обязательно). Свой ID покажет команда /id.
# Без этого списка бот не запустится: иначе любой человек сможет выполнять команды на сервере.
# Двое (например, вы и друг): ALLOWED_USER_IDS=123456789,987654321. Права у всех одинаковые
# (включая /sh и /git), поэтому вписывайте только тех, кому доверили бы сам сервер.
ALLOWED_USER_IDS=123456789

# Работа в группе (необязательно). ID чата покажет команда /id, у групп он отрицательный.
# Если список задан, бот отвечает только в перечисленных чатах.
#ALLOWED_CHAT_IDS=-1001234567890
# Командные группы: в них боту могут писать ВСЕ участники, а не только ALLOWED_USER_IDS
# (кто в группе, тот и допущен; следите за составом группы). Вне этих групп действует белый список.
#TEAM_CHAT_IDS=-1009876543210
# false — не отвечать в личных сообщениях (только в группах из ALLOWED_CHAT_IDS / TEAM_CHAT_IDS)
ALLOW_PRIVATE_CHATS=true
# true — у каждого чата (и темы) свой каталог проектов workspace/chat_<id>: группы не мешают друг другу,
# но репозиторий нужно клонировать в каждой группе отдельно
WORKSPACE_PER_CHAT=false
# true — в группе реагировать на обычный текст только при упоминании @бота или ответе на его сообщение
# (команды и /ask работают всегда). false — обрабатывать все сообщения разрешённых пользователей.
GROUP_REQUIRE_MENTION=false

# Авторизация Codex здесь НЕ задаётся: войдите один раз под пользователем сервиса
#   sudo bash deploy/codex-login.sh
# (вход аккаунтом ChatGPT с подпиской; учётные данные Codex хранит сам в ~/.codex/auth.json
# и обновляет автоматически). Не задавайте здесь CODEX_API_KEY, если хотите работать по подписке:
# с ним codex exec берёт ключ API вместо входа ChatGPT, и оплата идёт по тарифам API.

# Токен GitHub для git push / gh pr create (альтернатива `gh auth login` под пользователем сервиса).
# Fine-grained PAT с правами Contents: read/write и Pull requests: read/write на нужные репозитории.
#GH_TOKEN=

# Каталог, где живут проекты (клоны репозиториев). /projects и /clone работают внутри него.
WORKSPACE_DIR=~/workspace

# Путь к исполняемому файлу codex (по умолчанию ищется в PATH и ~/.local/bin)
#CODEX_BIN=/home/codexbot/.local/bin/codex

# Песочница Codex для команд, которые запускает агент:
#   danger-full-access — без песочницы и без подтверждений (нужно для автономной работы: git push,
#                        установка пакетов, сеть); агент может всё, что может пользователь сервиса.
#   workspace-write    — писать можно только в каталог проекта (и /tmp); сеть — по CODEX_NETWORK_ACCESS.
#   read-only          — только чтение.
CODEX_SANDBOX=danger-full-access
# Разрешить сеть внутри песочницы workspace-write (git push, pip install). На danger-full-access не влияет.
CODEX_NETWORK_ACCESS=true
# Поиск в интернете для агента: true (= live, живой поиск) | false (= disabled) | cached | indexed |
# default (как решит сам Codex).
CODEX_WEB_SEARCH=true

# Модель по умолчанию: точное имя (gpt-6-sol, gpt-6-astra, …). Пусто — модель выбирает сам Codex. В чате: /model
#CODEX_MODEL=
# Кнопки команды /model (значение — точное имя модели, подпись после двоеточия).
# ОБЫЧНО НЕ ЗАДАВАТЬ: по умолчанию бот показывает по одной кнопке на семейство (Astra, Sol, Luna)
# с точной последней версией; список живёт в config.py и обновляется вместе с ботом.
# Заданная здесь переменная перекрывает его целиком, а update.sh файл .env не трогает:
# устаревшая строка будет держать на кнопках старые модели.
#MODEL_BUTTONS=default,gpt-6-astra:GPT-6 Astra,gpt-6-sol:GPT-6 Sol,gpt-6-luna:GPT-6 Luna
# Уровень рассуждений по умолчанию: low | medium | high | xhigh | max. Пусто — по умолчанию модели. В чате: /effort
#CODEX_EFFORT=

# Предел на один запрос (ход). По умолчанию 3 часа: столько бот ждёт ответ,
# потом убивает всю сессию процессов запуска. Минимум 30.
CODEX_TIMEOUT_SECONDS=10800

# Сколько запусков codex могут идти одновременно (разные чаты/проекты).
# Сам codex лёгкий, но команды, которые он запускает (тесты, сборки), берут память.
# Для 4 ГБ разумно 2–3, для 8 ГБ — 5–6. Помните и про лимит подписки:
# параллельные запуски жгут его кратно быстрее.
MAX_CONCURRENT_RUNS=2

# Дополнительные флаги `codex exec`, обычно -c ключ=значение. Примеры:
#   -c model_reasoning_summary="auto"   — присылать конспекты рассуждений (видны в прогрессе как 🤔 …)
#   -c agents.enabled=false             — запретить агенту запускать субагентов
# Настройки чата (/model, /effort) и песочница из этого файла стоят позже и имеют приоритет.
# Флаги, которых нет у `codex exec resume` (-s, -C, --add-dir, -p, --color …), бот отклоняет.
#CODEX_EXTRA_ARGS=

# Дополнительные инструкции агенту (developer instructions): не задано — встроенный текст
# про Telegram, отправку файлов и предел хода; пустая строка — отключить.
#CODEX_EXTRA_INSTRUCTIONS=

# Реакции на сообщение пользователя: пока бот работает и когда ответил. Пустое значение или off — отключить.
# Допустимы только эмодзи из списка реакций Telegram (👀 👍 👌 🔥 ✍ 🤔 …); ✅ среди них нет.
REACTION_WORKING=👀
REACTION_DONE=👍

# Показывать в итоге число токенов запуска (↑ вход вместе с кэшем, ↓ ответы)
SHOW_TOKENS=true

# Затирание секретов в исходящем тексте (защита в глубину, НЕ граница безопасности).
# Бот всегда затирает точные значения TELEGRAM_BOT_TOKEN, OPENAI_API_KEY, CODEX_API_KEY,
# GH_TOKEN/GITHUB_TOKEN, токены из ~/.codex/auth.json и строки, похожие на токены
# Telegram/OpenAI/GitHub. Здесь можно перечислить доп. имена переменных окружения (через запятую).
#REDACT_ENV_NAMES=

# Разрешить команды /sh и /git (выполняются в каталоге проекта от имени пользователя сервиса).
# Даже при true они доступны ТОЛЬКО владельцу из ALLOWED_USER_IDS, не участникам командного чата.
ALLOW_SHELL=true

# Разрешить боту отправлять файлы в чат. Codex помечает файл строкой
# «TG_SEND_FILE: <путь>», и бот прикрепляет его к ответу. Отправляются только
# файлы ВНУТРИ рабочего каталога (не .env, не учётные данные).
ALLOW_SEND_FILES=true
SHELL_TIMEOUT_SECONDS=120

# Разрешить /project с путями вне WORKSPACE_DIR
ALLOW_ANY_DIR=false

# Задачи для GitHub (/task)
TASK_BRANCH_PREFIX=tg/
#TASK_BASE_BRANCH=main
TASK_AUTO_PR=true

# Как часто обновлять сообщение о прогрессе (сек.)
PROGRESS_INTERVAL_SECONDS=3

# Часовой пояс для времени в ответах бота (например, Europe/Moscow). По умолчанию UTC.
TIMEZONE=UTC

# DEBUG | INFO | WARNING
LOG_LEVEL=INFO
